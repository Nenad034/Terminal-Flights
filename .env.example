# --- Infra (docker-compose defaults) ---
# Host portovi namerno nisu GDS default-i (5432/6379/9092/9200) da bi mogli
# da rade uporedo sa drugim projektima na istoj mašini bez konflikta.
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5434
POSTGRES_PORT=5434
POSTGRES_DB=terminal_flights
POSTGRES_USER=terminal_flights
POSTGRES_PASSWORD=terminal_flights_dev

REDIS_HOST=localhost
REDIS_HOST_PORT=6382
REDIS_PORT=6382

KAFKA_HOST_PORT=9094
KAFKA_BROKERS=localhost:9094

OPENSEARCH_HOST_PORT=9201
OPENSEARCH_URL=http://localhost:9201

# --- Services ---
SUPPLIER_LAYER_PORT=4001
BOOKING_PORT=4002
SEARCH_FANOUT_PORT=4003
PRICING_PORT=4004
WEB_PORT=3000

# --- Supplier API keys (F1 — MVP koristi Duffel, §19) ---
DUFFEL_API_KEY=
DUFFEL_API_BASE=https://api.duffel.com

# --- Payments (§07/§19) ---
ADYEN_API_KEY=
STRIPE_SECRET_KEY=
